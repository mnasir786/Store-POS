{
  "name": "HD-POS",
  "version": "1.0.8",
  "description": "HD POS is a professional desktop Point of Sale application tailored for retail and vape stores.",
  "author": "HD POS Team",
  "private": true,
  "main": "start.js",
  "build": {
    "appId": "01",
    "directories": {
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@seald-io/nedb": "^4.1.2",
    "async": "^2.6.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.2",
    "btoa": "^1.2.1",
    "dotenv": "^17.4.2",
    "electron": ">=22.3.25",
    "electron-context-menu": "^0.15.1",
    "electron-store": "^5.1.0",
    "electron-winstaller": "^5.4.0",
    "express": "^4.19.2",
    "express-fileupload": "^1.1.6",
    "html2canvas": "^1.0.0-rc.5",
    "http": "0.0.0",
    "https": "^1.0.0",
    "is-port-reachable": "^2.0.1",
    "jquery": "^3.4.1",
    "jsbarcode": "^3.11.0",
    "jspdf": "^4.1.0",
    "macaddress": "^0.2.9",
    "moment": "^2.29.4",
    "multer": "^1.4.2",
    "path": "^0.12.7",
    "print-js": "^1.0.63",
    "socket.io": "^4.8.3",
    "sweetalert2": "^9.5.4",
    "xmlhttprequest": "^1.8.0"
  },
  "scripts": {
    "electron": "cross-env NODE_ENV=dev nodemon --exec \"\"electron .\"\"",
    "electron-build": "electron-builder",
    "package-win": "electron-packager . POS --overwrite --asar=false --platform=win32 --arch=x64 --icon=assets/images/icon.ico --prune=true --out=release-builds --version-string.ProductName=\"POS\"",
    "test": "node --test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^6.0.3",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^1.1.0",
    "electron-packager": "^17.1.2",
    "nodemon": "^3.1.14"
  }
}
